# WhatsApp Group Bot Configuration

# Prefijo para comandos del bot
BOT_PREFIX=!

# Límite de advertencias (predeterminado 2)
MAX_WARNINGS=2

# Mensaje de auto-respuesta para chats privados
AUTO_REPLY_MSG="Hola 👋\nEste es un bot de administración de grupos.\n\nPara ventas o consultas directas, por favor contáctame a mi número principal:\n📱 wa.me/51956815890"

# ── Inteligencia Artificial (Elige SOLO UNA opción) ──

# Opción 1: Gemini AI API Key (Consíguela gratis en aistudio.google.com)
GEMINI_API_KEY=

# Opción 2: OpenAI Compatible API (OpenAI, Groq, DeepSeek)
# Groq es gratis y ultrarrápido (consigue tu key en console.groq.com)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama3-8b-8192
# Número del owner (con código de país, sin + ni espacios)
# Ejemplo: 5491112345678
OWNER_NUMBER=

# Entorno
NODE_ENV=development

# ── Panel Web de Archivos ──
# Puerto del panel (default: 3001)
PANEL_PORT=3001

# Credenciales del panel (OBLIGATORIO para activar el panel)
PANEL_USER=admin
PANEL_PASS=
